# occams-agent — runtime config
# Copy to .env and fill in real values. .env is gitignored.

# --- Paths (usually leave as default) ---

# Where the shared vault lives. Default: repo root /vault.
VAULT_DIR=./vault

# Where the runtime looks for <slug>-agent/ profile dirs. Default: repo root.
PROFILES_DIR=.

# users.json mapping (sender phone / Slack id → identity). Gitignored.
USERS_FILE=./users.json

# --- Defaults ---

# Which CLI runs an agent turn when no /claude or /codex override is set.
DEFAULT_AGENT=claude

# Profile to use when a chat has no binding yet. The runtime falls back to the
# profile with `default: true` in its frontmatter if this is unset.
DEFAULT_PROFILE=admin

# Default timezone for scheduled jobs. Use IANA names so daylight saving time
# is handled correctly. America/New_York = US Eastern time.
DEFAULT_TIMEZONE=America/New_York

# Claude permission mode. bypassPermissions = no prompts (required for unattended).
# Tool access is still bounded by cwd + --add-dir.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Codex sandbox + approvals.
CODEX_SANDBOX=workspace-write
CODEX_BYPASS_APPROVALS=true

# Extra absolute paths to bind read-only into every strict-sandbox profile,
# comma-separated (e.g. a host-installed MCP server binary under /opt).
# Missing paths are skipped. Binding a path only makes it visible — it grants
# no credentials; those are scoped per profile in permissions.json.
SHARED_BIND_PATHS=

# --- Agent API (optional; off by default) ---

# Private control-plane HTTP API for a local dashboard or an Obsidian plugin:
# projects, kanban tasks, chats, runs, scheduled jobs, vault tree/file reads,
# stop/message controls. Every request needs `Authorization: Bearer <token>`.
# Keep it on localhost unless a VPN (e.g. Tailscale) + firewall restrict it —
# it can drive ANY profile, including admin.
ENABLE_AGENT_API=false
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8787
AGENT_API_TOKEN=change-me
# users.json slug that dashboard-originated messages run as.
AGENT_API_USER_SLUG=operator

# --- Inbound webhook (optional; off by default) ---

# Lets an external service trigger ONE stateless agent run per verified POST
# to http://127.0.0.1:<port>/hook/<WEBHOOK_PATH_SECRET>. Two fail-closed gates:
# the path secret AND an HMAC over the raw body. Binds localhost only — put a
# reverse proxy / tunnel in front for public reach. See src/webhook.js.
ENABLE_WEBHOOK=false
WEBHOOK_PORT=8788
WEBHOOK_PATH_SECRET=
WEBHOOK_SECRET=
# Signature header + algo + value prefix, e.g. x-signature / sha256 / "sha256=".
WEBHOOK_SIGNATURE_HEADER=x-signature
WEBHOOK_SIGNATURE_ALGO=sha256
WEBHOOK_SIGNATURE_PREFIX=sha256=
# Profile the triggered run uses (its sandbox + permissions apply). Required.
WEBHOOK_PROFILE=
WEBHOOK_MAX_CONCURRENT=4

# --- Channels ---

# WhatsApp via Baileys. Auth session stored in occams-agent-runtime/auth/ on first QR pair.
ENABLE_WHATSAPP=true

# Slack via Bolt Socket Mode. Required scopes: chat:write, app_mentions:read, im:history, im:read.
# Subscribe to: app_mention, message.im.
ENABLE_SLACK=false
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# --- Transcription (voice notes) ---

# Groq Whisper API. Required for transcribing audio messages in Slack/WhatsApp.
# Free tier: ~25 hours of audio/day. Get a key at console.groq.com.
# Per Groq's Services Agreement, customer audio is NOT used for training.
GROQ_API_KEY=
# Default model is fine; override to "whisper-large-v3" (slower, slightly better) if needed.
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Backups ---

# Fine-grained GitHub token (Contents: read/write on this repo) used by
# deploy/cron-backup.sh for the nightly vault snapshot push. Read from .env at
# run time; never stored in .git/config.
GITHUB_BACKUP_TOKEN=
